// Prisma schema — Fase 2 (banco real, substitui o mock de lib/data.ts).
// Aplica `npx prisma migrate dev` após definir DATABASE_URL / DIRECT_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // conexão pooler (runtime, serverless)
  directUrl = env("DIRECT_URL") // conexão direta (migrações / prisma studio)
}

model Store {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  color     String
  createdAt DateTime @default(now())
  offers    Offer[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  icon        String
  description String
  createdAt   DateTime @default(now())
  offers      Offer[]
}

model Offer {
  id              String      @id @default(cuid())
  slug            String      @unique
  title           String
  shortDescription String
  imageUrl        String
  originalPrice   Decimal     @db.Decimal(10, 2)
  currentPrice    Decimal     @db.Decimal(10, 2)
  affiliateUrl    String
  categoryId      String
  storeId         String
  createdAt       DateTime    @default(now())
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  store           Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  priceHistory    PricePoint[]

  @@index([categoryId])
  @@index([storeId])
}

model PricePoint {
  id         String   @id @default(cuid())
  price      Decimal  @db.Decimal(10, 2)
  capturedAt DateTime
  offerId    String
  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
}
