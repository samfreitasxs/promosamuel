# ===== WhatsApp Business Cloud API (Meta) =====
# Copie para ".env.local" e preencha. Nunca comite o .env.local (já está no .gitignore).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_TEMPLATE_NAME=promo_diaria
WHATSAPP_TEST_TO=5511999999999

# ===== Banco de dados (Vercel Postgres / Neon) =====
# DATABASE_URL = conexão pooler (runtime, serverless) — use a "pooled" do Vercel.
# DIRECT_URL   = conexão direta (migrações / prisma studio) — use a "non-pooling".
DATABASE_URL=
DIRECT_URL=

# ===== Painel admin =====
# Senha de acesso ao /admin e segredo p/ assinar o cookie de sessão.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
