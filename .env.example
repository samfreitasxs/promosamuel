# WhatsApp Business Cloud API (Meta)
# Copie para ".env.local" e preencha. Nunca comite o .env.local (já está no .gitignore).

# ID do número do seu canal (WhatsApp > API Setup > "From" / Phone number ID)
WHATSAPP_PHONE_NUMBER_ID=

# Access Token. Use token de System User (não o temporário de 24h do painel).
WHATSAPP_ACCESS_TOKEN=

# ID da WhatsApp Business Account (opcional, p/ webhooks/config)
WHATSAPP_WABA_ID=

# Nome do modelo de mensagem aprovado (usado para iniciar conversa)
WHATSAPP_TEMPLATE_NAME=promo_diaria

# Número de teste (formato internacional SEM o +) para validar antes de produzir
WHATSAPP_TEST_TO=5511999999999
